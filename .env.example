NODE_ENV="development"
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Supabase PostgreSQL (Transaction Pooler + Direct connection)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/archistudio_test"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/archistudio_test"

# JWT (replace with random secrets of at least 16 characters)
JWT_ACCESS_SECRET="replace-with-random-access-secret"
JWT_REFRESH_SECRET="replace-with-random-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_DAYS=30

# Backblaze B2 S3-Compatible Storage
STORAGE_PROVIDER="b2"
STORAGE_ENDPOINT="<endpoint-url-dari-detail-bucket>"
STORAGE_BUCKET="<bucket-name>"
STORAGE_ACCESS_KEY_ID="replace-with-keyId"
STORAGE_SECRET_ACCESS_KEY="replace-with-bucket-application-key"
STORAGE_UPLOAD_EXPIRES_SECONDS=300
STORAGE_VIEW_EXPIRES_SECONDS=900
