NODE_ENV="development"
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Supabase PostgreSQL (Transaction Pooler runtime + Direct connection untuk prisma migrate)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Autentikasi JWT (ADR-01: Header Authorization Bearer, tanpa cookie)
JWT_ACCESS_SECRET="ganti-dengan-secret-acak-minimal-32-karakter-access"
JWT_REFRESH_SECRET="ganti-dengan-secret-acak-minimal-32-karakter-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_DAYS=30

# Object Storage S3-Compatible (ADR-02: Cloudflare R2 sebagai default, mudah pindah via .env)
STORAGE_PROVIDER="r2"
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_BUCKET="archistudio-reports"
STORAGE_ACCESS_KEY_ID="isi-r2-access-key-id"
STORAGE_SECRET_ACCESS_KEY="isi-r2-secret-access-key"
STORAGE_UPLOAD_EXPIRES_SECONDS=300
STORAGE_VIEW_EXPIRES_SECONDS=900
