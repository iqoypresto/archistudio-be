NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/archistudio_test
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/archistudio_test
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-16-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-16-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Google Drive API credentials for the dedicated CIRA application folder.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
# 32-byte key encoded as 64 hex characters; encrypts resumable session URIs at rest.
FILE_SESSION_ENCRYPTION_KEY=

# Shared secret for the scheduled POST /api/v1/reports/upload-sessions/cleanup job.
UPLOAD_CLEANUP_TOKEN=
